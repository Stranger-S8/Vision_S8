# Vision_S8 Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# REQUIRED CONFIGURATION
# ======================

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# NOTE: Not required for CV-only analysis (/api/v1/audit/cv)
GEMINI_API_KEY="AIzaSyCjJMiVk7MVLnAE3BJsDJGl5a9gAZjkvaA"

# ======================
# SECURITY SETTINGS
# ======================

# API Key Authentication (RECOMMENDED for production)
# When enabled, clients must provide X-API-Key header
API_KEY_ENABLED=false
API_KEY=your-secret-api-key-here

# CORS Origins (comma-separated list of allowed origins)
# For local use, localhost is fine. For web deployment, restrict to your domains.
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://127.0.0.1"]

# ======================
# SERVER CONFIGURATION
# ======================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./vision_s8.db

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE_MB=50

# ======================
# AI MODEL SETTINGS
# ======================

GEMINI_MODEL=gemini-2.5-flash
MAX_RETRIES=3
RETRY_DELAY=1.0

# ======================
# LOGGING
# ======================

LOG_LEVEL=INFO
LOG_FILE=./logs/vision_s8.log

# ======================
# RATE LIMITING
# ======================

# Requests per minute per client IP
RATE_LIMIT_RPM=60

# ======================
# MARKETPLACE APIS (Optional)
# ======================

# For competitor comparison feature
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# AMAZON_PARTNER_TAG=
# EBAY_APP_ID=
